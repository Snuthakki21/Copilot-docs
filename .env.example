# Set these in your local shell; this file is a template and is not auto-loaded.
WB_ZOWE_PROFILE=YOUR_EXISTING_READ_ONLY_PROFILE
WB_DB2_MCP_URL=http://127.0.0.1:8766/mcp
WB_DB2_MCP_TOKEN=SET_A_PRIVATE_RANDOM_TOKEN
# OpenAI-compatible chat completion endpoint. Source egress requires consent.
WB_LLM_URL=https://YOUR_APPROVED_PROVIDER/v1/chat/completions
WB_LLM_MODEL=YOUR_APPROVED_MODEL
WB_LLM_TOKEN=YOUR_PRIVATE_TOKEN
WB_ALLOW_SOURCE_EGRESS=false
# Optional gateway only; keep this private.
WB_DB2_ODBC_CONNECTION=YOUR_IBM_ODBC_CONNECTION_STRING
