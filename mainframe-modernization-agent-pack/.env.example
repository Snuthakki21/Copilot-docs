# Copy to .env LOCALLY; never commit .env or paste its contents into Copilot/chat.
# Fill only local .env, not this tracked example. Quotes support spaces/#/$ literally.
# Db2 z/OS DRDA LOCATION: DB2_DATABASE must equal DB2_LOCATION_NAME for this adapter.
DB2_LOCATION_NAME=CHANGE_ME
DB2_DATABASE=CHANGE_ME
DB2_HOSTNAME=replace-with-db2-host.invalid
DB2_PORT=0
DB2_USERNAME=
DB2_PASSWORD=
DB2_SSL_CONNECTION=true
DB2_SSL_SERVER_CERTIFICATE=certs/db2-ca.cer
DB2_ALLOWED_SCHEMAS=CHANGE_ME
DB2_ALLOWED_TABLES=CHANGE_ME.CHANGE_ME
# Set true only after your DBA confirms this account has SELECT-only permissions.
DB2_READ_ONLY_ACCOUNT_CONFIRMED=
DB2_MAX_ROWS=100
DB2_MAX_BYTES=65536
DB2_QUERY_TIMEOUT_SECONDS=15
DB2_CONNECT_TIMEOUT_SECONDS=10
DB2_MAX_OFFSET=10000

# Separate z/OSMF HTTPS endpoint and trust chain; not the Db2 DDF endpoint.
ZOWE_HOST=replace-with-zosmf-host.invalid
ZOWE_PORT=443
ZOWE_USERNAME=
ZOWE_PASSWORD=
# Node needs PEM content, even when filename ends .cer. No private keys.
ZOWE_CA_CERTIFICATE=certs/zosmf-ca.cer
# Absolute approved Node executable and installed @zowe/cli JS entrypoint. No .cmd shim.
ZOWE_NODE_EXECUTABLE=
ZOWE_CLI_JS=

# Prefixes only (no wildcard); blank denies all dataset reads.
ZOWE_ALLOWED_DATASET_PREFIXES=
